# Copy this file to ".env.local" and fill in real values, then restart the site.

# Login password for the Manage dashboard (/admin). Choose a strong one.
ADMIN_PASSWORD=choose-a-strong-password

# Long random string used to sign the login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=paste-a-long-random-string-here
